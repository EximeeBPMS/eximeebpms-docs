<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="complaintDefinitions"
                  targetNamespace="http://eximeebpms.org/examples/adhoc"
                  exporter="Camunda Modeler" exporterVersion="5.x">

  <bpmn:process id="complaintHandling" name="Complaint handling" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="complaintReceived" name="Complaint received">
      <bpmn:outgoing>toHandleComplaint</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toHandleComplaint" sourceRef="complaintReceived" targetRef="handleComplaint" />

    <!-- A case worker chooses the next steps through the activation API. Each step runs as an inner flow of its
         own; its variables stay in it, and only its toolCallResult reaches the output collection. The case is
         done when a refund has been prepared: the completion condition sees the output collection, not the
         variables of the flows. -->
    <bpmn:adHocSubProcess id="handleComplaint" name="Handle complaint">
      <bpmn:extensionElements>
        <camunda:adHoc outputCollection="results">
          <camunda:outputElement>${toolCallResult}</camunda:outputElement>
        </camunda:adHoc>
      </bpmn:extensionElements>
      <bpmn:incoming>toHandleComplaint</bpmn:incoming>
      <bpmn:outgoing>toInformCustomer</bpmn:outgoing>

      <bpmn:userTask id="lookupOrder" name="Look up order">
        <bpmn:documentation>Finds the order the complaint is about. Expects orderId.</bpmn:documentation>
      </bpmn:userTask>
      <bpmn:userTask id="askCustomer" name="Ask customer">
        <bpmn:documentation>Asks the customer for missing details, e.g. a receipt.</bpmn:documentation>
      </bpmn:userTask>
      <bpmn:userTask id="checkWarranty" name="Check warranty">
        <bpmn:outgoing>toPrepareRefund</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="toPrepareRefund" sourceRef="checkWarranty" targetRef="prepareRefund" />
      <bpmn:userTask id="prepareRefund" name="Prepare refund">
        <bpmn:incoming>toPrepareRefund</bpmn:incoming>
      </bpmn:userTask>

      <bpmn:completionCondition xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${results.contains('refund prepared')}</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="toInformCustomer" sourceRef="handleComplaint" targetRef="informCustomer" />

    <bpmn:userTask id="informCustomer" name="Inform customer">
      <bpmn:documentation>Sees the results of every step of the case in the variable results.</bpmn:documentation>
      <bpmn:incoming>toInformCustomer</bpmn:incoming>
      <bpmn:outgoing>toComplaintHandled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toComplaintHandled" sourceRef="informCustomer" targetRef="complaintHandled" />
    <bpmn:endEvent id="complaintHandled" name="Complaint handled">
      <bpmn:incoming>toComplaintHandled</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="complaintDiagram">
    <bpmndi:BPMNPlane id="complaintPlane" bpmnElement="complaintHandling">
      <bpmndi:BPMNShape id="complaintReceived_di" bpmnElement="complaintReceived">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="137" y="295" width="67" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handleComplaint_di" bpmnElement="handleComplaint" isExpanded="true">
        <dc:Bounds x="250" y="80" width="520" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lookupOrder_di" bpmnElement="lookupOrder">
        <dc:Bounds x="300" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askCustomer_di" bpmnElement="askCustomer">
        <dc:Bounds x="300" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="checkWarranty_di" bpmnElement="checkWarranty">
        <dc:Bounds x="300" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareRefund_di" bpmnElement="prepareRefund">
        <dc:Bounds x="480" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toPrepareRefund_di" bpmnElement="toPrepareRefund">
        <di:waypoint x="400" y="380" />
        <di:waypoint x="480" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="informCustomer_di" bpmnElement="informCustomer">
        <dc:Bounds x="830" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="complaintHandled_di" bpmnElement="complaintHandled">
        <dc:Bounds x="992" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="978" y="295" width="65" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toHandleComplaint_di" bpmnElement="toHandleComplaint">
        <di:waypoint x="188" y="270" />
        <di:waypoint x="250" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toInformCustomer_di" bpmnElement="toInformCustomer">
        <di:waypoint x="770" y="270" />
        <di:waypoint x="830" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toComplaintHandled_di" bpmnElement="toComplaintHandled">
        <di:waypoint x="930" y="270" />
        <di:waypoint x="992" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
