{{/* Keep Enterprise-only pages on their actual versioned canonical path. */}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{ range .Data.Pages }}
  <url>
    <loc>{{ .Site.Params.canonicalBasePath }}{{ .RelPermalink }}</loc>
    {{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
    {{ with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    {{ if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
    {{ if .IsTranslated }}{{ range .AllTranslations }}
      <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Site.Params.canonicalBasePath }}{{ .RelPermalink }}" />
    {{ end }}{{ end }}
  </url>
{{ end }}
</urlset>
